
# From @BotFather (use a freshly revoked token, not one you've shared)
TELEGRAM_BOT_TOKEN=MentionChatbot

# AI provider: "gemini" (default) or "openai"
AI_PROVIDER=gemini

# Google Gemini API key (free tier): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=keyinfo
GEMINI_MODEL=gemini-1.5-flash

# OpenAI (only needed if AI_PROVIDER=openai): https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Local timezone used for reminders (e.g. Asia/Kolkata, America/New_York)
TIMEZONE=Asia/Kolkata

# Path to the SQLite database file
DB_PATH=agent.db
